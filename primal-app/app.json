{
  "expo": {
    "name": "PRIMAL",
    "slug": "primal",
    "scheme": "primal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo/logo-braise.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#050505",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.primal.nutrition"
    },
    "android": {
      "package": "app.primal.nutrition",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo/logo-braise-adaptive.png",
        "backgroundColor": "#050505"
      },
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACTIVITY_RECOGNITION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "backgroundColor": "#050505"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "PRIMAL utilise l'appareil photo pour scanner les codes-barres des produits."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "PRIMAL accède à tes photos pour choisir ta photo de profil."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "PRIMAL utilise les mouvements du téléphone pour animer les particules lumineuses."
        }
      ],
      "expo-notifications",
      "expo-audio",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo/logo-braise.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#050505"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "owner": "reyflow",
    "extra": {
      "eas": {
        "projectId": "b2eedb39-50c0-4115-90ba-b8343eb071f8"
      }
    }
  }
}
